{
  "permissions": {
    "deny": [
      "Bash(uv run cmfkit fw pack:*)",
      "Bash(uv run cmfkit fw replace:*)",
      "Bash(cmfkit fw pack:*)",
      "Bash(cmfkit fw replace:*)",
      "Bash(*ota*upload*)",
      "Bash(openocd:*)",
      "Bash(st-flash:*)",
      "Bash(JLinkExe:*)",
      "Bash(pyocd:*)"
    ],
    "ask": [
      "Bash(uv run cmfkit pair:*)",
      "Bash(uv run cmfkit notify:*)",
      "Bash(uv run cmfkit run:*)",
      "Bash(uv run cmfkit watchface install:*)",
      "Bash(uv run cmfkit at:*)",
      "Bash(cmfkit pair:*)",
      "Bash(cmfkit notify:*)",
      "Bash(cmfkit run:*)",
      "Bash(cmfkit watchface install:*)",
      "Bash(cmfkit at:*)",
      "Bash(bash scripts/phase0_live.sh:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/cmf-hook start 2>/dev/null || true", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/cmf-hook stop 2>/dev/null || true", "timeout": 10, "async": true }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/cmf-hook notify 2>/dev/null || true", "timeout": 10, "async": true }
        ]
      }
    ]
  }
}
